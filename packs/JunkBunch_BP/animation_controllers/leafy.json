{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.leafy.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            { "leafy_idle": { "weight": "query.is_on_ground" } },
            { "leafy_float": { "weight": "!query.is_on_ground" } }
          ],
          "transitions": [
            { "moving": "query.ground_speed > 0.1" }
          ]
        },
        "moving": {
          "animations": [
            { "leafy_walk": { "weight": "query.is_on_ground" } },
            { "leafy_float": { "weight": "!query.is_on_ground" } }
          ],
          "transitions": [
            { "default": "query.ground_speed <= 0.1" }
          ]
        }
      }
    },
    "controller.animation.leafy.ability": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            { "floating": "query.is_item_name_any('hand', 'junkbunch:summon_rake') && query.is_using_item" }
          ]
        },
        "floating": {
          "animations": [
            { "leafy_ability_float": {} }
          ],
          "transitions": [
            { "idle": "!query.is_item_name_any('hand', 'junkbunch:summon_rake') || !query.is_using_item" }
          ]
        }
      }
    }
  }
}
