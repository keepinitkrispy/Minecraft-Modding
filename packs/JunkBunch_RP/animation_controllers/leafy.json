{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.leafy.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "walk": "query.modified_move_speed > 0.1" }
          ]
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [
            { "idle": "query.modified_move_speed <= 0.1" }
          ]
        }
      }
    },
    "controller.animation.leafy.float": {
      "initial_state": "grounded",
      "states": {
        "grounded": {
          "transitions": [
            { "floating": "!query.is_on_ground" }
          ]
        },
        "floating": {
          "animations": ["float"],
          "transitions": [
            { "grounded": "query.is_on_ground" }
          ]
        }
      }
    }
  }
}
