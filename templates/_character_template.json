{
  "format_version": "1.20.50",
  "minecraft:entity": {
    "description": {
      "identifier": "junkbunch:character_name",
      "is_summonable": true,
      "is_spawnable": true,
      "is_experimental": false
    },
    "component_groups": {
      "following_player": {
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.0
        }
      },
      "idle": {
        "minecraft:behavior.look_at_player": {
          "priority": 10,
          "look_distance": 8.0
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["mob", "junkbunch"]
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:nameable": {},
      "minecraft:physics": {},
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:annotation.break_door": {},
      "minecraft:rideable": {
        "seat_count": 0,
        "family_types": []
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:behavior.wander": {
        "priority": 11,
        "speed_multiplier": 1.0
      },
      "minecraft:leashable": {
        "soft_distance": 4.0,
        "hard_distance": 6.0,
        "max_distance": 10.0
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": [
                { "test": "is_family", "subject": "other", "value": "player" }
              ]
            },
            "use_item": false,
            "swing_hand": true
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["idle"]
        }
      }
    }
  }
}
