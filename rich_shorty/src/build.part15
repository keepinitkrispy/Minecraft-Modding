
# ---------------------------------------------------------------------------
# FABRICATOR PERFORMANCE + MATERIAL PASS
# Creator Tools correctly warns above 50 cubes for custom blocks. Compress the
# small controls/cable details into texture art and keep the authored silhouette
# at 48 cubes, with explicit UV material zones so the machine reads in-game.
# ---------------------------------------------------------------------------

def fabricator_geometry():
    cubes=[]
    UV_DARK=[0,0]; UV_METAL=[16,0]; UV_GLOW=[32,0]; UV_WARN=[48,0]
    UV_SCREEN=[0,16]; UV_COPPER=[16,16]; UV_DEEP=[32,16]; UV_LIGHT=[48,16]
    def c(origin,size,uv=UV_DARK): cubes.append({'origin':list(origin),'size':list(size),'uv':list(uv)})

    # 3-tier foundation = 3
    c((-8,0,-8),(16,2,16),UV_DARK)
    c((-7,2,-7),(14,1,14),UV_METAL)
    c((-6,3,-6),(12,1,12),UV_DEEP)

    # feet + lower anchors = 8 (11)
    for x,z in [(-6,-6),(4,-6),(-6,4),(4,4)]:
        c((x,4,z),(2,8,2),UV_METAL)
        c((x-.5,4,z-.5),(3,1,3),UV_DARK)

    # main tapered reactor shell = 3 (14)
    c((-5,4,-5),(10,6,10),UV_DEEP)
    c((-4.3,10,-4.3),(8.6,3,8.6),UV_METAL)
    c((-5.3,13,-5.3),(10.6,1.2,10.6),UV_WARN)

    # four side service pods = 4 (18)
    c((-7.2,6,-3),(2.2,5,6),UV_COPPER)
    c((5.0,6,-3),(2.2,5,6),UV_COPPER)
    c((-3,6,5.0),(6,5,2.2),UV_METAL)
    c((-3,6,-7.2),(6,5,2.2),UV_METAL)

    # front console = 3 (21); button bank lives in texture instead of cubes
    c((-4.6,5,-9.0),(9.2,4.5,2.0),UV_DARK)
    c((-3.8,9.5,-9.5),(7.6,2.0,1.2),UV_SCREEN)
    c((-3.0,11.5,-9.1),(6.0,1.0,.9),UV_WARN)

    # stepped aperture outer frame = 10 (31)
    for x,y,w,h in [
        (-5.5,15,2.0,4.0),(-4.6,17,1.6,4.0),(-3.2,18.8,1.5,2.8),(-1.4,19.8,1.5,2.8),
        (.4,19.8,1.5,2.8),(2.2,18.8,1.5,2.8),(3.6,17,1.6,4.0),(4.5,15,2.0,4.0)
    ]: c((x,y,-2.2),(w,h,4.4),UV_METAL)
    c((-4.0,14.5,-2.4),(8.0,1.2,4.8),UV_WARN)
    c((-3.0,20.8,-2.0),(6.0,1.2,4.0),UV_WARN)

    # inner glowing throat = 4 (35)
    c((-3.3,16.0,-2.8),(6.6,.65,5.6),UV_GLOW)
    c((-3.3,18.0,-2.8),(6.6,.65,5.6),UV_GLOW)
    c((-3.3,16.6,-2.9),(.65,1.4,5.8),UV_GLOW)
    c((2.65,16.6,-2.9),(.65,1.4,5.8),UV_GLOW)

    # asymmetrical condenser / pipe runs = 6 (41)
    c((-9.0,5,2.5),(2.0,9,2.0),UV_COPPER)
    c((-9.6,13,2.0),(3.2,2.0,3.0),UV_COPPER)
    c((-9.0,15,2.5),(2.0,3.5,2.0),UV_GLOW)
    c((7.0,4,-4.5),(1.4,7,1.4),UV_METAL)
    c((7.0,10,-4.5),(3.0,1.4,1.4),UV_METAL)
    c((8.6,10,-4.5),(1.4,5,1.4),UV_GLOW)

    # two exposed bus bars = 2 (43), reduced from six
    c((-2.0,12.9,5.5),(.55,3.2,.55),UV_GLOW)
    c((1.45,12.9,5.5),(.55,3.2,.55),UV_GLOW)

    # beacon / antenna = 3 (46)
    c((-.9,22,-.9),(1.8,2.0,1.8),UV_WARN)
    c((-.3,24,-.3),(.6,3.0,.6),UV_METAL)
    c((-2.4,24.8,-.3),(4.8,.5,.6),UV_GLOW)

    # two side warning lamps = 2 (48)
    c((-7.65,9.0,-3.7),(.5,1.6,1.4),UV_WARN)
    c((7.15,9.0,-3.7),(.5,1.6,1.4),UV_WARN)

    return {'format_version':'1.12.0','minecraft:geometry':[{'description':{
        'identifier':'geometry.keepinitkrispy_rs.reality_fabricator','texture_width':64,'texture_height':64,
        'visible_bounds_width':3.2,'visible_bounds_height':3.8,'visible_bounds_offset':[0,1.3,0]
    },'bones':[{'name':'machine','pivot':[0,0,0],'cubes':cubes}]}]}


# The earlier make_pack wrapper writes the texture; replace it after packaging
# with a deliberate material atlas matching the UV regions above, then reseal.
_fab48_make_pack = make_pack

def make_pack():
    addon=_fab48_make_pack()
    fabtex=RP/f'textures/blocks/{ASSET_CREATOR}/{ASSET_PACK}/reality_fabricator.png'
    if fabtex.exists():
        im=Image.new('RGBA',(64,64),(35,46,54,255)); d=ImageDraw.Draw(im)
        swatches={
          (0,0):(35,46,54,255), (16,0):(79,96,104,255), (32,0):(94,239,178,255), (48,0):(226,181,57,255),
          (0,16):(18,39,44,255), (16,16):(139,91,60,255), (32,16):(23,31,38,255), (48,16):(185,213,208,255)
        }
        for (x,y),col in swatches.items():
            d.rectangle((x,y,x+15,y+15),fill=col)
            # panel seams / small highlights remain inside each material cell
            d.line((x,y+7,x+15,y+7),fill=tuple(max(0,v-18) for v in col[:3])+(255,),width=1)
            d.line((x+7,y,x+7,y+15),fill=tuple(min(255,v+12) for v in col[:3])+(255,),width=1)
        # animated-looking portal streaks within green swatch
        for yy in (3,7,11): d.line((33,yy,46,yy),fill=(192,255,224,255),width=1)
        # screen glyphs
        d.rectangle((2,18,13,29),fill=(11,26,31,255)); d.line((3,27,7,22,10,24,13,19),fill=(103,248,188,255),width=1)
        # caution hatch in warning swatch
        for xx in range(48,64,4): d.line((xx,0,min(63,xx+7),7),fill=(77,62,31,255),width=2)
        im.save(fabtex)
    if addon.exists(): addon.unlink()
    with zipfile.ZipFile(addon,'w',zipfile.ZIP_DEFLATED) as z:
        for pack in (BP,RP):
            for f in pack.rglob('*'):
                if f.is_file(): z.write(f,f.relative_to(OUT))
    return addon
