
# ---------------------------------------------------------------------------
# BETA REALITY VALIDATION METADATA
# TEST 55 proved the new Beta candidate gate, but build.part29's fail-closed
# metadata survived into the report even after build.part30 replaced that route.
# Keep the report aligned with the artifact that actually ships.
# ---------------------------------------------------------------------------
_beta_metadata_previous_validate = validate


def validate(addon: Path):
    report = _beta_metadata_previous_validate(addon)
    report['reality_travel_status'] = 'true custom-dimension portal transit implemented; retail Beta APIs runtime verification pending'
    report['runtime_verification_status'] = 'PENDING_ANDROID_RETAIL_BETA_APIS'
    report['verified_not_same_dimension_overworld_teleport'] = True
    jwrite(OUT/'validation_report.json', report)
    return report
