
# TEST 58 retail fix: remove the original raised driveway stripe command rather
# than relying on the later furnishing pass to erase it after construction.
SCRIPT = SCRIPT.replace(
    "  for(let dz=-15;dz<=-10;dz+=2) fillb(d,x+4,y,z+dz,x+11,y,z+dz,'minecraft:light_gray_concrete');\n",
    "  // Driveway surface pattern is authored flush at y-1 by polishStarterBase.\n",
    1
)

_driveway_source_previous_validate = validate

def validate(addon:Path):
    report=_driveway_source_previous_validate(addon)
    errors=list(report.get('errors',[])); checks=int(report.get('checks',0))
    script=(BP/'scripts/main.js').read_text(encoding='utf-8')
    checks+=1
    bad="fillb(d,x+4,y,z+dz,x+11,y,z+dz,'minecraft:light_gray_concrete')"
    if bad in script:
        errors.append('driveway source regression: raised stripe command survives final shipping script')
    report['checks']=checks
    report['errors']=errors
    report['status']='PASS' if not errors else 'FAIL'
    jwrite(OUT/'validation_report.json',report)
    return report
