# Rebuild every featured model from the sculpted style. These are the objects
# seen by the already-wrapped make_pack() when packaging finally executes.
CHAR_MODELS = [
    hd_rich(), hd_shorty(False), hd_shorty(True), hd_bess(), hd_gerry(), hd_sundae(),
    hd_bird_dude(), hd_scronchy(), hd_needs_it(), hd_professor_poop(), hd_captain_drizzle(),
    hd_nightmare_larry(), hd_sprocket(), hd_consensus(), hd_cucumber(), hd_krombo(),
    hd_shorty_jr(), hd_validator(), hd_franky(), hd_council_rich()
]

# Character-specific animation polish. Keep the same three named animations so
# existing client entity references remain stable, but vary personality beats.
_hd_base_animations = animations

def animations(name:str):
    obj=_hd_base_animations(name)
    anims=obj['animations']
    idle=anims[f'animation.keepinitkrispy_rs.{name}.idle'] if f'animation.keepinitkrispy_rs.{name}.idle' in anims else anims.get(f'animation.rs.{name}.idle')
    walk=anims[f'animation.keepinitkrispy_rs.{name}.walk'] if f'animation.keepinitkrispy_rs.{name}.walk' in anims else anims.get(f'animation.rs.{name}.walk')
    talk=anims[f'animation.keepinitkrispy_rs.{name}.talk'] if f'animation.keepinitkrispy_rs.{name}.talk' in anims else anims.get(f'animation.rs.{name}.talk')
    if idle:
        if name in ('shorty','shorty_jr'):
            idle['bones']['body']={'rotation':{'0.0':[0,0,-1.5],'0.8':[1.2,0,1.5],'1.6':[0,0,-1.5]}}
            idle['bones']['head']={'rotation':{'0.0':[1,-5,0],'.45':[-2,4,0],'.9':[2,-3,0],'1.6':[1,-5,0]}}
        elif name in ('rich','council_rich'):
            idle['bones']['head']={'rotation':{'0.0':[-2,-4,0],'.2':[1,7,0],'.35':[-2,-5,0],'2.4':[-2,-4,0]}}
        elif name=='bird_dude':
            idle['bones']['left_upper_arm']={'rotation':{'0.0':[0,0,-8],'1.2':[0,0,-16],'2.4':[0,0,-8]}}
            idle['bones']['right_upper_arm']={'rotation':{'0.0':[0,0,8],'1.2':[0,0,16],'2.4':[0,0,8]}}
        elif name=='cucumber_rich':
            idle['bones']['left_lower_arm']={'rotation':{'0.0':[0,0,-8],'.6':[0,0,16],'1.2':[0,0,-8]}}
            idle['bones']['right_lower_arm']={'rotation':{'0.0':[0,0,8],'.6':[0,0,-16],'1.2':[0,0,8]}}
    if talk and name in ('gerry','professor_poop'):
        talk['bones']['left_lower_arm']={'rotation':{'0.0':[-10,0,20],'.45':[-55,0,35],'.9':[-10,0,20]}}
    return obj


# Improve the Fabricator at the same visual gate: asymmetrical reactor silhouette,
# stepped luminous aperture, pipes, control bank, coil towers, and service legs.
def fabricator_geometry():
    cubes=[]
    def c(origin,size,uv=(0,0),rotation=None,pivot=None):
        q={'origin':list(origin),'size':list(size),'uv':list(uv)}
        if rotation is not None: q['rotation']=list(rotation)
        if pivot is not None: q['pivot']=list(pivot)
        cubes.append(q)
    # layered hex-ish pedestal via offsets
    c((-8,0,-8),(16,2,16)); c((-7,2,-7),(14,1,14)); c((-6,3,-6),(12,1,12))
    # four reactor feet and lower service bays
    for x,z in [(-6,-6),(4,-6),(-6,4),(4,4)]:
        c((x,4,z),(2,8,2)); c((x-.5,4,z-.5),(3,1,3))
    c((-5,4,-5),(10,6,10)); c((-4.3,10,-4.3),(8.6,3,8.6)); c((-5.3,13,-5.3),(10.6,1.2,10.6))
    # inset side tanks / asymmetry
    c((-7.2,6,-3),(2.2,5,6)); c((5.0,6,-3),(2.2,5,6))
    c((-3,6,5.0),(6,5,2.2)); c((-3,6,-7.2),(6,5,2.2))
    # front console bank with stepped screen hood / buttons
    c((-4.6,5,-9.0),(9.2,4.5,2.0)); c((-3.8,9.5,-9.5),(7.6,2.0,1.2)); c((-3.0,11.5,-9.1),(6.0,1.0,.9))
    for x in (-2.4,-.8,.8,2.4): c((x-.35,7.0,-9.65),(.7,.7,.5))
    # upper aperture frame: stair-step oval, more recognizable than a slab
    for x,y,w in [(-5.5,15,2.0),(-4.6,17,1.6),(-3.2,18.8,1.5),(-1.4,19.8,1.5),(.4,19.8,1.5),(2.2,18.8,1.5),(3.6,17,1.6),(4.5,15,2.0)]:
        c((x,y,-2.2),(w,4.0 if y<18 else 2.8,4.4))
    c((-4.0,14.5,-2.4),(8.0,1.2,4.8)); c((-3.0,20.8,-2.0),(6.0,1.2,4.0))
    # inner glowing throat bars and field nodes
    c((-3.3,16.0,-2.8),(6.6,.65,5.6)); c((-3.3,18.0,-2.8),(6.6,.65,5.6))
    c((-3.3,16.6,-2.9),(.65,1.4,5.8)); c((2.65,16.6,-2.9),(.65,1.4,5.8))
    # asymmetrical pipes and condenser stacks
    c((-9.0,5,2.5),(2.0,9,2.0)); c((-9.6,13,2.0),(3.2,2.0,3.0)); c((-9.0,15,2.5),(2.0,3.5,2.0))
    c((7.0,4,-4.5),(1.4,7,1.4)); c((7.0,10,-4.5),(3.0,1.4,1.4)); c((8.6,10,-4.5),(1.4,5,1.4))
    # exposed cables / bus bars
    for i,x in enumerate([-4.5,-2.7,-.9,.9,2.7,4.5]): c((x,12.9,5.5),(.45,3.2,.45))
    # top warning beacon and antenna
    c((-.9,22,-.9),(1.8,2.0,1.8)); c((-.3,24,-.3),(.6,3.0,.6)); c((-2.4,24.8,-.3),(4.8,.5,.6))
    return {'format_version':'1.12.0','minecraft:geometry':[{'description':{'identifier':'geometry.keepinitkrispy_rs.reality_fabricator','texture_width':64,'texture_height':64,'visible_bounds_width':3.2,'visible_bounds_height':3.8,'visible_bounds_offset':[0,1.3,0]},'bones':[{'name':'machine','pivot':[0,0,0],'cubes':cubes}]}]}


# More sophisticated machine material: panel breaks, glowing aperture strips,
# hazard marks and screen glyphs while remaining a single small 64px texture.
_hd_old_make_pack = make_pack

def make_pack():
    addon=_hd_old_make_pack()
    # Finalizer already moved block texture into the creator/pack folder.
    fabtex=RP/f'textures/blocks/{ASSET_CREATOR}/{ASSET_PACK}/reality_fabricator.png'
    if fabtex.exists():
        im=Image.new('RGBA',(64,64),(39,52,60,255)); d=ImageDraw.Draw(im)
        for y in range(0,64,8): d.line((0,y,63,y),fill=(50,70,76,255),width=1)
        for x in range(0,64,8): d.line((x,0,x,63),fill=(34,45,53,255),width=1)
        # luminous field swatches live at UV 0 because block geometry uses uv 0,0;
        # texture variation still gives faces material breakup in game.
        for x in range(4,64,12): d.rectangle((x,3,x+2,60),fill=(101,231,173,255))
        d.rectangle((10,10,53,19),fill=(15,30,35,255)); d.rectangle((14,12,49,17),fill=(104,243,187,255))
        for x in range(12,49,6): d.rectangle((x,23,x+2,26),fill=(226,193,76,255))
        for i in range(6):
            x=6+i*9; d.polygon([(x,48),(x+5,48),(x+9,56),(x+4,56)],fill=(209,165,52,255))
        im.save(fabtex)
    # Re-seal because the texture was polished after the namespace finalizer.
    if addon.exists(): addon.unlink()
    with zipfile.ZipFile(addon,'w',zipfile.ZIP_DEFLATED) as z:
        for pack in (BP,RP):
            for f in pack.rglob('*'):
                if f.is_file(): z.write(f,f.relative_to(OUT))
    return addon
