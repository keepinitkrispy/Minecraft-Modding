def hd_cucumber():
    m=Model('cucumber_rich',.95,1.35)
    b=m.bone('body',(0,7.0,0))
    # tall rounded cucumber built from ellipsoid runs, with bumps and rat-tech harness
    _ellipsoid_runs(b,0,7.8,0,3.7,7.0,2.8,'green','green_light','green')
    for x,y,z in [(-3.5,8,-1.8),(3.0,10,-1.5),(-2.5,4.2,2.0),(2.4,6.1,2.1),(.5,13,-2.3)]: _c(b,(x,y,z),(1.0,1.0,1.0),'green_light')
    _c(b,(-3.8,5.2,2.0),(7.6,1.0,.85),'metal_dark')
    _c(b,(-1.0,3.9,2.0),(2.0,3.5,.7),'red')
    h=m.bone('head',(0,10.0,0),'body')
    for x in (-2.6,.6): _c(h,(x,10.1,-3.15),(2.0,1.5,.55),'eye')
    _c(h,(-1.9,10.4,-3.5),(.7,.8,.35),'pupil'); _c(h,(1.1,10.4,-3.5),(.7,.8,.35),'pupil')
    _c(h,(-1.7,8.6,-3.2),(3.4,.55,.45),'mouth')
    # articulated scavenged limbs
    for side in (-1,1):
        x=-3.8 if side<0 else 3.8; un='left_upper_arm' if side<0 else 'right_upper_arm'; ln='left_lower_arm' if side<0 else 'right_lower_arm'
        u=m.bone(un,(x,8.0,0),'body'); _c(u,(x-2.0 if side<0 else x,6.6,-.7),(2.2,1.0,1.4),'metal_light'); _c(u,(x-1.5 if side<0 else x+.5,5.7,-1.1),(1.0,2.0,2.2),'metal_dark')
        l=m.bone(ln,(x,6.2,0),un); _c(l,(x-3.0 if side<0 else x,4.7,-.6),(3.0,1.0,1.2),'metal_light'); _c(l,(x-3.5 if side<0 else x+2.5,4.0,-1.0),(1.1,1.8,2.0),'metal_dark')
    for side in (-1,1):
        x=-2.7 if side<0 else .4; un='left_upper_leg' if side<0 else 'right_upper_leg'; ln='left_lower_leg' if side<0 else 'right_lower_leg'
        u=m.bone(un,((-1.7 if side<0 else 1.7),2.7,0),'body'); _c(u,(x,.4,-.9),(2.4,2.7,1.8),'metal_light')
        l=m.bone(ln,((-1.7 if side<0 else 1.7),.5,0),un); _c(l,(x+.2,-1.4,-.8),(2.0,2.0,1.6),'metal_dark'); _c(l,(x-.3,-1.7,-2.0),(3.0,.8,3.0),'shoe')
    return m


