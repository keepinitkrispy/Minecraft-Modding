
# ---------------------------------------------------------------------------
# MOBILE TEST-BUILD IDENTITIES
# Retail Android testing disproved reliable in-place replacement for our
# side-loaded workflow even with stable UUIDs + higher manifest versions.
# During active testing, make every CI artifact intentionally coexist instead:
# each run gets a distinct RP/BP/module UUID set and a visible [TEST N] label.
# Ryan only activates the newest matching pair; old imports can stay in Storage
# until final cleanup. Final release identity is handled separately later.
# ---------------------------------------------------------------------------


def _mobile_test_run():
    try:
        return max(1,int(os.environ.get('GITHUB_RUN_NUMBER','1')))
    except Exception:
        return 1


def _mobile_test_uuid(run:int, name:str)->str:
    return str(uuid.uuid5(uuid.NAMESPACE_URL, f'rich-shorty/mobile-test/{run}/{name}'))


def _mobile_test_identity():
    run=_mobile_test_run()
    return {
      'run':run,
      'version':[0,3,run],
      'bp_header':_mobile_test_uuid(run,'bp/header'),
      'bp_data':_mobile_test_uuid(run,'bp/data'),
      'bp_script':_mobile_test_uuid(run,'bp/script'),
      'rp_header':_mobile_test_uuid(run,'rp/header'),
      'rp_resources':_mobile_test_uuid(run,'rp/resources'),
    }


_mobile_test_make_pack = make_pack
_mobile_test_validate = validate


def make_pack():
    addon = _mobile_test_make_pack()
    ident=_mobile_test_identity(); run=ident['run']; ver=ident['version']

    bp_path=BP/'manifest.json'; rp_path=RP/'manifest.json'
    bp=json.loads(bp_path.read_text(encoding='utf-8'))
    rp=json.loads(rp_path.read_text(encoding='utf-8'))

    bp['header']['uuid']=ident['bp_header']
    rp['header']['uuid']=ident['rp_header']
    bp['header']['version']=ver
    rp['header']['version']=ver

    for module in bp.get('modules',[]):
        if module.get('type')=='data':
            module['uuid']=ident['bp_data']; module['version']=ver
        elif module.get('type')=='script':
            module['uuid']=ident['bp_script']; module['version']=ver
    for module in rp.get('modules',[]):
        if module.get('type')=='resources':
            module['uuid']=ident['rp_resources']; module['version']=ver

    for dep in bp.get('dependencies',[]):
        if isinstance(dep,dict) and 'uuid' in dep:
            dep['uuid']=ident['rp_header']
            dep['version']=ver

    # Make the currently active pair impossible to confuse with stale test packs.
    bp['header']['name']=f'Rich & Shorty BP [TEST {run}]'
    rp['header']['name']=f'Rich & Shorty RP [TEST {run}]'
    bp['header']['description']=f'Parody multiverse adventure — behavior — mobile TEST {run}'
    rp['header']['description']=f'Parody multiverse adventure — resources — mobile TEST {run}'

    jwrite(bp_path,bp); jwrite(rp_path,rp)

    if addon.exists(): addon.unlink()
    with zipfile.ZipFile(addon,'w',zipfile.ZIP_DEFLATED) as zf:
        for pack in (BP,RP):
            for f in pack.rglob('*'):
                if f.is_file(): zf.write(f,f.relative_to(OUT))
    return addon


def validate(addon:Path):
    report=_mobile_test_validate(addon)
    errors=list(report.get('errors',[])); checks=int(report.get('checks',0))
    ident=_mobile_test_identity(); run=ident['run']; ver=ident['version']
    bp=json.loads((BP/'manifest.json').read_text(encoding='utf-8'))
    rp=json.loads((RP/'manifest.json').read_text(encoding='utf-8'))

    checks += 12
    if bp.get('header',{}).get('uuid') != ident['bp_header']:
        errors.append('mobile test identity regression: BP header UUID is not build-specific')
    if rp.get('header',{}).get('uuid') != ident['rp_header']:
        errors.append('mobile test identity regression: RP header UUID is not build-specific')
    if bp.get('header',{}).get('version') != ver or rp.get('header',{}).get('version') != ver:
        errors.append('mobile test identity regression: BP/RP versions do not match current test run')
    if bp.get('header',{}).get('name') != f'Rich & Shorty BP [TEST {run}]':
        errors.append('mobile test identity regression: BP visible build label missing')
    if rp.get('header',{}).get('name') != f'Rich & Shorty RP [TEST {run}]':
        errors.append('mobile test identity regression: RP visible build label missing')

    bpmods={m.get('type'):m for m in bp.get('modules',[]) if isinstance(m,dict)}
    rpmods={m.get('type'):m for m in rp.get('modules',[]) if isinstance(m,dict)}
    if bpmods.get('data',{}).get('uuid') != ident['bp_data'] or bpmods.get('data',{}).get('version') != ver:
        errors.append('mobile test identity regression: BP data module mismatch')
    if bpmods.get('script',{}).get('uuid') != ident['bp_script'] or bpmods.get('script',{}).get('version') != ver:
        errors.append('mobile test identity regression: BP script module mismatch')
    if rpmods.get('resources',{}).get('uuid') != ident['rp_resources'] or rpmods.get('resources',{}).get('version') != ver:
        errors.append('mobile test identity regression: RP resource module mismatch')

    uuiddeps=[d for d in bp.get('dependencies',[]) if isinstance(d,dict) and d.get('uuid')]
    if not any(d.get('uuid')==ident['rp_header'] and d.get('version')==ver for d in uuiddeps):
        errors.append('mobile test identity regression: BP dependency does not match current test RP')

    # A build must not accidentally fall back to the original/final UUID set.
    if bp.get('header',{}).get('uuid') == UUIDS['bp_header'] or rp.get('header',{}).get('uuid') == UUIDS['rp_header']:
        errors.append('mobile test identity regression: test build reused final/stable pack identity')

    report['mobile_import_strategy']='coexisting build-specific TEST identities; activate newest matching BP/RP pair'
    report['mobile_build_version']=ver
    report['mobile_test_run']=run
    report['mobile_test_bp_uuid']=ident['bp_header']
    report['mobile_test_rp_uuid']=ident['rp_header']
    gates=[g for g in report.get('feature_regression_gates',[]) if g!='mobile_in_place_pack_updates']
    if 'mobile_coexisting_test_builds' not in gates:
        gates.append('mobile_coexisting_test_builds')
    report['feature_regression_gates']=gates
    report['checks']=checks; report['errors']=errors
    report['status']='PASS' if not errors else 'FAIL'
    jwrite(OUT/'validation_report.json',report)
    return report
