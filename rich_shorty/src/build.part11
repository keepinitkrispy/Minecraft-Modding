
# ---------------------------------------------------------------------------
# COOPERATIVE / MARKETPLACE HYGIENE
# Namespace is intentionally creator + pack specific. This late pack-finalizer
# rewrites the proven generated content before the archive is sealed, and moves
# texture assets into creator/pack folders so unrelated Add-Ons cannot collide.
# ---------------------------------------------------------------------------
FINAL_NS = 'keepinitkrispy_rs'
ASSET_CREATOR = 'keepinitkrispy'
ASSET_PACK = 'rich_shorty'

_pre_hygiene_make_pack = make_pack
_pre_hygiene_validate = validate


def _rewrite_text_file(path: Path):
    text = path.read_text(encoding='utf-8')
    replacements = [
        ('geometry.rs.', f'geometry.{FINAL_NS}.'),
        ('animation.rs.', f'animation.{FINAL_NS}.'),
        ('controller.render.rs_default', f'controller.render.{FINAL_NS}_default'),
        ('textures/entity/rs/', f'textures/entity/{ASSET_CREATOR}/{ASSET_PACK}/'),
        ('rs_started', f'{FINAL_NS}_started'),
        ('rs_fabricated', f'{FINAL_NS}_fabricated'),
        ('rs_phase2', f'{FINAL_NS}_phase2'),
        ('rs_phase3', f'{FINAL_NS}_phase3'),
        ('rs_q_', f'{FINAL_NS}_q_'),
        ('rs:', f'{FINAL_NS}:'),
    ]
    for old,new in replacements:
        text = text.replace(old,new)
    path.write_text(text,encoding='utf-8')


def _namespace_texture_catalogs():
    # Entity skins: creator/pack nested path.
    old_entity = RP/'textures/entity/rs'
    new_entity = RP/f'textures/entity/{ASSET_CREATOR}/{ASSET_PACK}'
    if old_entity.exists():
        new_entity.parent.mkdir(parents=True,exist_ok=True)
        if new_entity.exists(): shutil.rmtree(new_entity)
        shutil.move(str(old_entity),str(new_entity))

    # Item textures and references.
    item_catalog_path = RP/'textures/item_texture.json'
    item_catalog = json.loads(item_catalog_path.read_text(encoding='utf-8'))
    old_item_dir = RP/'textures/items'
    new_item_dir = old_item_dir/ASSET_CREATOR/ASSET_PACK
    new_item_dir.mkdir(parents=True,exist_ok=True)
    for png in list(old_item_dir.glob('*.png')):
        shutil.move(str(png),str(new_item_dir/png.name))
    new_item_data = {}
    icon_map = {}
    for key,val in item_catalog.get('texture_data',{}).items():
        new_key=f'{FINAL_NS}_{key}'
        paths=val.get('textures',[])
        if isinstance(paths,str): paths=[paths]
        moved=[]
        for p in paths:
            filename=Path(p).name
            moved.append(f'textures/items/{ASSET_CREATOR}/{ASSET_PACK}/{filename}')
        new_item_data[new_key]={'textures':moved}
        icon_map[key]=new_key
    item_catalog['texture_data']=new_item_data
    jwrite(item_catalog_path,item_catalog)
    for item_file in (BP/'items').glob('*.json'):
        obj=json.loads(item_file.read_text(encoding='utf-8'))
        comps=obj.get('minecraft:item',{}).get('components',{})
        icon=comps.get('minecraft:icon')
        if isinstance(icon,str) and icon in icon_map: comps['minecraft:icon']=icon_map[icon]
        jwrite(item_file,obj)

    # Block textures and texture-reference keys.
    terrain_path=RP/'textures/terrain_texture.json'
    terrain=json.loads(terrain_path.read_text(encoding='utf-8'))
    old_block_dir=RP/'textures/blocks'
    new_block_dir=old_block_dir/ASSET_CREATOR/ASSET_PACK
    new_block_dir.mkdir(parents=True,exist_ok=True)
    for png in list(old_block_dir.glob('*.png')):
        shutil.move(str(png),str(new_block_dir/png.name))
    new_terrain={}; block_tex_map={}
    for key,val in terrain.get('texture_data',{}).items():
        new_key=f'{FINAL_NS}_{key}'
        paths=val.get('textures',[])
        if isinstance(paths,str): paths=[paths]
        moved=[f'textures/blocks/{ASSET_CREATOR}/{ASSET_PACK}/{Path(p).name}' for p in paths]
        new_terrain[new_key]={'textures':moved}; block_tex_map[key]=new_key
    terrain['texture_data']=new_terrain; jwrite(terrain_path,terrain)
    for block_file in (BP/'blocks').glob('*.json'):
        obj=json.loads(block_file.read_text(encoding='utf-8'))
        mats=obj.get('minecraft:block',{}).get('components',{}).get('minecraft:material_instances',{})
        for mat in mats.values():
            if isinstance(mat,dict) and mat.get('texture') in block_tex_map:
                mat['texture']=block_tex_map[mat['texture']]
        jwrite(block_file,obj)


def make_pack():
    addon=_pre_hygiene_make_pack()
    # Rewrite identifiers in all generated text assets first.
    for root in (BP,RP):
        for f in root.rglob('*'):
            if f.is_file() and f.suffix.lower() in ('.json','.js','.lang'):
                _rewrite_text_file(f)
    _namespace_texture_catalogs()

    # Re-seal the archive only after the final namespace/path layout exists.
    if addon.exists(): addon.unlink()
    with zipfile.ZipFile(addon,'w',zipfile.ZIP_DEFLATED) as z:
        for pack in (BP,RP):
            for f in pack.rglob('*'):
                if f.is_file(): z.write(f,f.relative_to(OUT))
    return addon


def validate(addon:Path):
    report=_pre_hygiene_validate(addon)
    errors=list(report.get('errors',[])); checks=int(report.get('checks',0))
    # Final namespace gate.
    for root in (BP,RP):
        for f in root.rglob('*'):
            if f.is_file() and f.suffix.lower() in ('.json','.js','.lang'):
                checks+=1; text=f.read_text(encoding='utf-8')
                if 'rs:' in text:
                    errors.append(f'{f}: legacy rs: namespace survived finalization')
    # Actual shipped entity textures must exist, be opaque, and live under creator/pack path.
    tex_dir=RP/f'textures/entity/{ASSET_CREATOR}/{ASSET_PACK}'
    for m in CHAR_MODELS:
        checks+=2; f=tex_dir/f'{m.name}.png'
        if not f.exists():
            errors.append(f'missing namespaced entity texture {f}'); continue
        im=Image.open(f).convert('RGBA')
        if any(a<255 for *_,a in im.getdata()): errors.append(f'{f}: transparent texels')
    checks+=1
    if (RP/'textures/entity/rs').exists(): errors.append('legacy textures/entity/rs folder still exists')
    report['checks']=checks; report['errors']=errors; report['status']='PASS' if not errors else 'FAIL'
    report['namespace']=FINAL_NS
    report['sha256']=hashlib.sha256(addon.read_bytes()).hexdigest()
    jwrite(OUT/'validation_report.json',report)
    return report
