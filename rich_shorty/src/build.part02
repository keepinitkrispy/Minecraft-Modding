    if skirt: body.cubes += [Cube((-4.2,6,-2.3),(8.4,3.2,4.6),'purple')]
    add_face(model, 17.3, skin, hair, elder=elder, visor=visor)
    # articulated limbs with upper/lower bones and distinct hands/feet
    lua=model.bone('left_upper_arm',(-4.5,13.2,0),'body'); lua.cubes=[Cube((-6.4,8.5,-1.6),(2.4,5.1,3.2),torso)]
    lla=model.bone('left_lower_arm',(-5.2,9.0,0),'left_upper_arm'); lla.cubes=[Cube((-6.1,4.7,-1.45),(2.0,4.4,2.9),skin),Cube((-6.35,3.4,-1.7),(2.5,1.8,3.4),skin)]
    rua=model.bone('right_upper_arm',(4.5,13.2,0),'body'); rua.cubes=[Cube((4,8.5,-1.6),(2.4,5.1,3.2),torso)]
    rla=model.bone('right_lower_arm',(5.2,9.0,0),'right_upper_arm'); rla.cubes=[Cube((4.1,4.7,-1.45),(2.0,4.4,2.9),skin),Cube((3.85,3.4,-1.7),(2.5,1.8,3.4),skin)]
    lul=model.bone('left_upper_leg',(-2.1,7.3,0),'body'); lul.cubes=[Cube((-3.8,2.8,-1.7),(3.3,4.7,3.4),pants)]
    lll=model.bone('left_lower_leg',(-2.1,3.1,0),'left_upper_leg'); lll.cubes=[Cube((-3.5,-1.1,-1.55),(2.7,4.3,3.1),pants),Cube((-3.8,-1.5,-3.0),(3.3,1.7,4.5),'shoe')]
    rul=model.bone('right_upper_leg', (2.1,7.3,0),'body'); rul.cubes=[Cube((0.5,2.8,-1.7),(3.3,4.7,3.4),pants)]
    rll=model.bone('right_lower_leg',(2.1,3.1,0),'right_upper_leg'); rll.cubes=[Cube((0.8,-1.1,-1.55),(2.7,4.3,3.1),pants),Cube((0.5,-1.5,-3.0),(3.3,1.7,4.5),'shoe')]



def scale_model(m:Model, sx=1.0, sy=1.0, sz=1.0):
    for bone in m.bones:
        bone.pivot=(bone.pivot[0]*sx,bone.pivot[1]*sy,bone.pivot[2]*sz)
        for c in bone.cubes:
            c.origin=(c.origin[0]*sx,c.origin[1]*sy,c.origin[2]*sz)
            c.size=(c.size[0]*sx,c.size[1]*sy,c.size[2]*sz)
            if c.pivot is not None: c.pivot=(c.pivot[0]*sx,c.pivot[1]*sy,c.pivot[2]*sz)
    return m

def model_rich():
    m=Model('rich',1.2,2.1); add_humanoid(m,skin='skin_rich',hair='hair_rich',torso='shirt_teal',pants='pants_tan',elder=True,coat=True)
    body=next(x for x in m.bones if x.name=='body'); head=next(x for x in m.bones if x.name=='head')
    body.cubes += [Cube((-1,12.8,-3.0),(2,3.2,0.7),'white'),Cube((-2,11.0,-3.0),(4,1,0.7),'visor_dark'),Cube((-4.2,9.2,-3.15),(2.8,1.0,0.65),'coat_shadow'),Cube((1.4,9.2,-3.15),(2.8,1.0,0.65),'coat_shadow')]
    head.cubes += [Cube((-3.7,19.2,-4.2),(3.0,0.65,0.55),'hair_rich'),Cube((0.7,19.2,-4.2),(3.0,0.65,0.55),'hair_rich'),Cube((-2.0,15.0,-3.95),(4.0,0.55,0.5),'tooth')]
    return scale_model(m,0.94,1.08,0.96)

def model_shorty(evil=False):
    m=Model('evil_shorty' if evil else 'shorty',1.1,1.8)
    add_humanoid(m,skin='skin_shorty',hair='hair_shorty',torso='shirt_black' if evil else 'shirt_amber',pants='pants_dark',visor=evil)
    head=next(x for x in m.bones if x.name=='head'); body=next(x for x in m.bones if x.name=='body')
    head.cubes += [Cube((-3.6,19.2,-4.15),(2.6,0.55,0.5),'hair_shorty'),Cube((1.0,19.2,-4.15),(2.6,0.55,0.5),'hair_shorty')]
    if evil:
      body.cubes += [Cube((-5.0,6.2,1.0),(10,9,1.1),'darkgrey'),Cube((-1,12.0,-3.1),(2,2,0.8),'visor'),Cube((-4.8,13.6,-2.8),(9.6,1.2,5.6),'visor_dark'),Cube((-2.2,8.1,-3.0),(4.4,1.1,0.7),'visor')]
      head.cubes += [Cube((-4.4,17.0,2.3),(8.8,7.5,1.0),'darkgrey')]
    else:
      body.cubes += [Cube((-3.3,10.0,-3.0),(6.6,1.0,0.65),'yellow')]
    return scale_model(m,0.96,0.90,0.96)

