def model_bird_dude():
    m=Model('bird_dude',1.2,2.0)
    body=m.bone('body',(0,13,0)); body.cubes=[Cube((-4.5,8,-2.5),(9,8,5),'feather'),Cube((-5.1,11,-2.8),(10.2,3.2,5.6),'feather'),Cube((-3.8,6.8,-2.1),(7.6,2.2,4.2),'bird'),Cube((-6,10,0),(3,6,1.3),'bird'),Cube((3,10,0),(3,6,1.3),'bird'),Cube((-1.2,7.2,2.0),(2.4,5.2,1.3),'yellow')]
    add_face(m,17.5,'bird','bird',bird=True)
    lua=m.bone('left_upper_arm',(-4.5,13.5,0),'body'); lua.cubes=[Cube((-7,9,-1.2),(3,5,2.4),'feather')]
    lla=m.bone('left_lower_arm',(-5.7,9.4,0),'left_upper_arm'); lla.cubes=[Cube((-8,5.5,-1),(2.6,4,2),'feather')]
    rua=m.bone('right_upper_arm',(4.5,13.5,0),'body'); rua.cubes=[Cube((4,9,-1.2),(3,5,2.4),'feather')]
    rla=m.bone('right_lower_arm',(5.7,9.4,0),'right_upper_arm'); rla.cubes=[Cube((5.4,5.5,-1),(2.6,4,2),'feather')]
    for side,s in [('left',-1),('right',1)]:
      u=m.bone(f'{side}_upper_leg',(2*s,8,0),'body'); u.cubes=[Cube(((0.5 if s>0 else -3.5),3,-1.4),(3,5,2.8),'bird')]
      l=m.bone(f'{side}_lower_leg',(2*s,3.4,0),f'{side}_upper_leg'); l.cubes=[Cube(((0.8 if s>0 else -3.2),-1,-1.1),(2.4,4.2,2.2),'bird'),Cube(((0 if s>0 else -4),-1.6,-3),(4,1.3,4.2),'yellow')]
    return m

