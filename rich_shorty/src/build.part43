
# ---------------------------------------------------------------------------
# REALITY ART-DIRECTION PASS — ATMOSPHERE + AUTHORED LANDMARKS
# TEST 72 retail feedback was explicit: transport is fixed, but the custom
# dimensions still look like ugly default-sky void spaces and feel empty/boring.
# part42 adds the first fog/density layer. This pass hardens the current fog API
# path, adds volumetric atmosphere where supported, and gives every streamed
# sector a deterministic designed focal landmark + route language. The goal is
# not "more random blocks"; it is readable composition, vertical depth, skyline
# silhouettes, and a reason to walk toward something in every direction.
# ---------------------------------------------------------------------------
_reality_art_previous_make_pack = make_pack
_reality_art_previous_validate = validate


def make_pack():
    addon=_reality_art_previous_make_pack()

    # Harden the fog files produced by part42 with volumetric air. Distance fog
    # works broadly; volumetric media adds depth on render paths that support it.
    volumetric={
      'glorp':  ('#184B43','#071B18',0.12),
      'fizz':   ('#7A3422','#260C07',0.11),
      'chrono': ('#303A72','#0A0C22',0.10),
      'scrap':  ('#41464F','#111317',0.13),
      'citadel':('#315F69','#0B2025',0.09),
    }
    for key,(scatter,absorb,density) in volumetric.items():
        path=RP/f'fogs/{key}.fog.json'
        if not path.exists():
            raise RuntimeError(f'missing part42 reality fog for {key}')
        obj=json.loads(path.read_text(encoding='utf-8'))
        settings=obj['minecraft:fog_settings']
        settings['volumetric']={
          'density':{
            'air':{
              'max_density':density,
              'max_density_height':72,
              'zero_density_height':150
            }
          },
          'media_coefficients':{
            'air':{
              'scattering':scatter,
              'absorption':absorb
            }
          }
        }
        jwrite(path,obj)

    script_path=BP/'scripts/main.js'
    script=script_path.read_text(encoding='utf-8')

    # Use the current Player.fogSettings property when present. Keep the
    # EntityFogComponent fallback because the Beta module can straddle API cuts.
    old="""  try{\n    const fog=player.getComponent('minecraft:player.fog');\n    if(fog){\n      fog.remove(RS_REALITY_FOG_TAG);\n      if(wanted) fog.push(wanted,RS_REALITY_FOG_TAG);\n    }\n  }catch{}"""
    new="""  try{\n    let fog=null;\n    try{ fog=player.fogSettings; }catch{}\n    if(!fog){ try{ fog=player.getComponent('minecraft:player.fog'); }catch{} }\n    if(fog){\n      fog.remove(RS_REALITY_FOG_TAG);\n      if(wanted) fog.push(wanted,RS_REALITY_FOG_TAG);\n    }\n  }catch{}"""
    if old not in script:
        raise RuntimeError('part42 fog application block not found for API hardening')
    script=script.replace(old,new,1)

    old_hook="""  rsEnrichRealitySector(dim,key,sx,sz,c.x,y,c.z,theme);\n  rsAuthorSectorGameplay(dim,key,sx,sz,c.x,y,c.z,theme);"""
    new_hook="""  rsEnrichRealitySector(dim,key,sx,sz,c.x,y,c.z,theme);\n  rsAuthorSignatureLandmark(dim,key,sx,sz,c.x,y,c.z,theme);\n  rsAuthorSectorGameplay(dim,key,sx,sz,c.x,y,c.z,theme);"""
    if old_hook not in script:
        raise RuntimeError('part42 enrichment hook not found for landmark pass')
    script=script.replace(old_hook,new_hook,1)

    script += r'''

// -------------------------------------------------------------------------
// AUTHORED LANDMARK LANGUAGE
// Each sector gets ONE major readable landmark chosen deterministically from a
// reality-specific kit. These are deliberately large, asymmetric compositions
// with paths/rooms/platforms, not scatter decoration. They make exploration
// readable from the next island and prevent the repeated "flat pad + spikes"
// look that failed TEST 72 retail review.
// -------------------------------------------------------------------------
function rsLandmarkVariant(key,sx,sz){ return rsDeterministic(`landmark_${key}`,sx,sz,313)%4; }

function rsPath(dim,x1,y,z1,x2,z2,block,width=2){
  const dx=x2-x1,dz=z2-z1,steps=Math.max(Math.abs(dx),Math.abs(dz));
  if(steps<=0) return;
  for(let i=0;i<=steps;i++){
    const x=Math.round(x1+dx*i/steps),z=Math.round(z1+dz*i/steps);
    fillb(dim,x-width,y,z-width,x+width,y,z+width,block);
  }
}

function rsGlorpLandmark(dim,v,cx,y,cz,t){
  if(v===0){
    // ROOT CATHEDRAL — huge arching fungal roots with a luminous heart chamber.
    rsArch(dim,cx,y+2,cz,15,22,'minecraft:warped_stem','minecraft:sea_lantern','x');
    rsArch(dim,cx,y+2,cz,12,18,'minecraft:warped_stem','minecraft:amethyst_block','z');
    fillb(dim,cx-5,y+2,cz-5,cx+5,y+7,cz+5,'minecraft:dark_prismarine hollow');
    fillb(dim,cx-3,y+3,cz-3,cx+3,y+6,cz+3,'minecraft:air');
    setb(dim,cx,y+4,cz,'minecraft:sea_lantern');
  }else if(v===1){
    // BUBBLE BOG — stepped slime terraces around a sunken water/amethyst eye.
    for(let r=14,h=1;r>=5;r-=3,h++){
      fillb(dim,cx-r,y+h,cz-r,cx+r,y+h,cz+r,r%2?'minecraft:moss_block':'minecraft:warped_nylium');
    }
    fillb(dim,cx-5,y+5,cz-5,cx+5,y+5,cz+5,'minecraft:water');
    fillb(dim,cx-2,y+4,cz-2,cx+2,y+4,cz+2,'minecraft:amethyst_block');
    setb(dim,cx,y+6,cz,'minecraft:sea_lantern');
  }else if(v===2){
    // SHARD GROVE — tilted-looking crystal forest with walkable root bridges.
    for(const [dx,dz,h] of [[-10,-8,18],[-4,9,24],[7,-5,20],[11,8,15],[0,1,28]]){
      fillb(dim,cx+dx-1,y+1,cz+dz-1,cx+dx+1,y+h,cz+dz+1,'minecraft:amethyst_block');
      setb(dim,cx+dx,y+h+1,cz+dz,'minecraft:sea_lantern');
      rsPath(dim,cx,y+2,cz,cx+dx,cz+dz,'minecraft:dark_prismarine',1);
    }
  }else{
    // GIANT CAP — a mushroom-like canopy big enough to explore underneath.
    fillb(dim,cx-2,y+1,cz-2,cx+2,y+19,cz+2,'minecraft:warped_stem');
    for(let r=4;r<=13;r+=3){
      fillb(dim,cx-r,y+17+(13-r)//3 if false else y+20,cz-r,cx+r,y+20,cz+r,'minecraft:warped_wart_block');
    }
    fillb(dim,cx-10,y+21,cz-10,cx+10,y+21,cz+10,'minecraft:warped_wart_block');
    for(const [dx,dz] of [[-8,-8],[8,-8],[-8,8],[8,8]]) setb(dim,cx+dx,y+19,cz+dz,'minecraft:sea_lantern');
  }
}

function rsFizzLandmark(dim,v,cx,y,cz,t){
  if(v===0){
    // FURNACE TEMPLE — blackstone shell, hot core, high basalt smoke stacks.
    fillb(dim,cx-10,y+1,cz-8,cx+10,y+10,cz+8,'minecraft:blackstone hollow');
    fillb(dim,cx-7,y+2,cz-6,cx+7,y+8,cz+6,'minecraft:air');
    fillb(dim,cx-3,y+1,cz-3,cx+3,y+1,cz+3,'minecraft:magma');
    for(const x of [-8,8]) for(const z of [-6,6]) fillb(dim,cx+x-1,y+10,cz+z-1,cx+x+1,y+28,cz+z+1,'minecraft:basalt');
    rsPath(dim,cx,y+2,cz-15,cx,cz-8,'minecraft:orange_terracotta',2);
  }else if(v===1){
    // IMPACT CRATER — concentric red mesas with glowing cracked center.
    for(let r=15,h=1;r>=6;r-=3,h++){
      fillb(dim,cx-r,y+h,cz-r,cx+r,y+h,cz+r,h%2?'minecraft:red_sandstone':'minecraft:orange_terracotta');
    }
    fillb(dim,cx-5,y+5,cz-5,cx+5,y+6,cz+5,'minecraft:air');
    fillb(dim,cx-3,y+4,cz-3,cx+3,y+4,cz+3,'minecraft:magma');
    setb(dim,cx,y+5,cz,'minecraft:lava');
  }else if(v===2){
    // BASALT RIBS — enormous fossil/furnace arches forming a traversal tunnel.
    for(let z=-12;z<=12;z+=4) rsArch(dim,cx,y+1,cz+z,12,16,'minecraft:basalt','minecraft:shroomlight','x');
    rsPath(dim,cx,y+2,cz-15,cx,cz+15,'minecraft:red_sandstone',2);
  }else{
    // SUSPENDED SMELTERY — two towers linked by a high bridge over magma.
    for(const x of [-10,10]){
      fillb(dim,cx+x-4,y+1,cz-5,cx+x+4,y+22,cz+5,'minecraft:blackstone hollow');
      fillb(dim,cx+x-2,y+3,cz-3,cx+x+2,y+20,cz+3,'minecraft:air');
    }
    fillb(dim,cx-10,y+16,cz-2,cx+10,y+18,cz+2,'minecraft:orange_terracotta');
    fillb(dim,cx-6,y+1,cz-3,cx+6,y+1,cz+3,'minecraft:magma');
  }
}

function rsChronoLandmark(dim,v,cx,y,cz,t){
  if(v===0){
    // BROKEN HOURGLASS — two quartz chambers pinched around an amethyst throat.
    fillb(dim,cx-10,y+2,cz-5,cx+10,y+4,cz+5,'minecraft:smooth_quartz');
    fillb(dim,cx-7,y+5,cz-4,cx+7,y+8,cz+4,'minecraft:calcite');
    fillb(dim,cx-3,y+9,cz-3,cx+3,y+14,cz+3,'minecraft:amethyst_block');
    fillb(dim,cx-7,y+15,cz-4,cx+7,y+18,cz+4,'minecraft:calcite');
    fillb(dim,cx-10,y+19,cz-5,cx+10,y+21,cz+5,'minecraft:smooth_quartz');
    for(const x of [-10,10]) for(const z of [-5,5]) fillb(dim,cx+x,y+2,cz+z,cx+x,y+21,cz+z,'minecraft:blue_ice');
  }else if(v===1){
    // ARCHIVE STACK — walkable alternating shelves spiraling upward.
    for(let i=0;i<7;i++){
      const yy=y+2+i*3,off=(i%2===0)?-7:7;
      fillb(dim,cx-12,yy,cz+off-2,cx+12,yy+1,cz+off+2,i%2?'minecraft:calcite':'minecraft:smooth_quartz');
      setb(dim,cx+(i%2?10:-10),yy+2,cz+off,'minecraft:end_rod');
    }
  }else if(v===2){
    // CLOCK FACE PLAZA — vertical ring, hands, and accessible lower gallery.
    rsSkyRing(dim,cx,y+18,cz+9,14,'minecraft:amethyst_block','minecraft:end_rod','xy');
    fillb(dim,cx-1,y+6,cz+9,cx+1,y+30,cz+9,'minecraft:blue_ice');
    fillb(dim,cx,y+17,cz+9,cx+10,y+19,cz+9,'minecraft:smooth_quartz');
    fillb(dim,cx-12,y+2,cz+5,cx+12,y+4,cz+13,'minecraft:calcite hollow');
  }else{
    // FROZEN SWITCHYARD — raised rails of ice/quartz crossing at impossible levels.
    for(const yy of [3,8,13]){
      fillb(dim,cx-15,y+yy,cz-2,cx+15,y+yy+1,cz+2,yy===8?'minecraft:blue_ice':'minecraft:smooth_quartz');
      fillb(dim,cx-2,y+yy+1,cz-15,cx+2,y+yy+2,cz+15,yy===8?'minecraft:amethyst_block':'minecraft:calcite');
    }
    for(const [dx,dz] of [[-14,-14],[14,-14],[-14,14],[14,14]]) fillb(dim,cx+dx,y+1,cz+dz,cx+dx,y+15,cz+dz,'minecraft:end_rod');
  }
}

function rsScrapLandmark(dim,v,cx,y,cz,t){
  if(v===0){
    // CRASHED SHIP — long asymmetrical hull with open cargo bays and torn nose.
    fillb(dim,cx-16,y+3,cz-6,cx+13,y+9,cz+6,'minecraft:iron_block hollow');
    fillb(dim,cx-13,y+4,cz-4,cx+10,y+8,cz+4,'minecraft:air');
    fillb(dim,cx+13,y+4,cz-3,cx+16,y+8,cz+3,'minecraft:cut_copper');
    for(const x of [-9,-2,5]) fillb(dim,cx+x,y+2,cz-5,cx+x+4,y+2,cz+5,'minecraft:oxidized_cut_copper');
    rsPath(dim,cx-15,y+2,cz,cx-8,cz,'minecraft:deepslate_tiles',2);
  }else if(v===1){
    // CRUSHER PIT — industrial ring with suspended hammer and lower salvage floor.
    fillb(dim,cx-14,y+1,cz-14,cx+14,y+3,cz+14,'minecraft:polished_deepslate');
    fillb(dim,cx-10,y+2,cz-10,cx+10,y+4,cz+10,'minecraft:air');
    for(const [dx,dz] of [[-12,-12],[12,-12],[-12,12],[12,12]]) fillb(dim,cx+dx-1,y+3,cz+dz-1,cx+dx+1,y+18,cz+dz+1,'minecraft:iron_block');
    fillb(dim,cx-5,y+15,cz-5,cx+5,y+18,cz+5,'minecraft:iron_block');
    fillb(dim,cx-1,y+4,cz-1,cx+1,y+14,cz+1,'minecraft:chain');
  }else if(v===2){
    // ANTENNA FARM — dense forest of asymmetric masts and horizontal dishes.
    for(const [dx,dz,h] of [[-11,-10,23],[-5,7,17],[3,-7,26],[10,8,20],[12,-2,14]]){
      fillb(dim,cx+dx,y+1,cz+dz,cx+dx+1,y+h,cz+dz+1,'minecraft:iron_block');
      fillb(dim,cx+dx-4,y+h-3,cz+dz,cx+dx+5,y+h-1,cz+dz,'minecraft:oxidized_cut_copper');
      setb(dim,cx+dx,y+h+1,cz+dz,'minecraft:redstone_lamp');
    }
  }else{
    // FACTORY SPINE — multiple rooms connected by a raised service gantry.
    for(const x of [-11,0,11]){
      fillb(dim,cx+x-5,y+2,cz-6,cx+x+5,y+11,cz+6,x===0?'minecraft:deepslate_tiles':'minecraft:oxidized_cut_copper hollow');
      if(x!==0) fillb(dim,cx+x-3,y+3,cz-4,cx+x+3,y+9,cz+4,'minecraft:air');
    }
    fillb(dim,cx-15,y+12,cz-2,cx+15,y+14,cz+2,'minecraft:iron_block');
    for(let x=-12;x<=12;x+=6) setb(dim,cx+x,y+15,cz,'minecraft:redstone_lamp');
  }
}

function rsCitadelLandmark(dim,v,cx,y,cz,t,sx,sz){
  if(sx===0&&sz===0) return; // story Citadel owns the center.
  if(v===0){
    // Records tower with open atrium and bridge-facing entrance.
    fillb(dim,cx-9,y+1,cz-9,cx+9,y+34,cz+9,'minecraft:dark_prismarine hollow');
    fillb(dim,cx-6,y+3,cz-6,cx+6,y+31,cz+6,'minecraft:air');
    for(let yy=y+6;yy<=y+30;yy+=6) fillb(dim,cx-8,yy,cz-8,cx+8,yy,cz+8,'minecraft:quartz_bricks');
    setb(dim,cx,y+35,cz,'minecraft:beacon');
  }else if(v===1){
    // Bureaucratic plaza — low civic ring around a beacon monument.
    for(const r of [14,10,6]){
      fillb(dim,cx-r,y+1+(14-r)//4,cz-r,cx+r,y+1+(14-r)//4,cz+r,'minecraft:quartz_bricks');
    }
    fillb(dim,cx-2,y+4,cz-2,cx+2,y+19,cz+2,'minecraft:oxidized_cut_copper');
    setb(dim,cx,y+20,cz,'minecraft:sea_lantern');
  }else if(v===2){
    // Customs hall — wide, walkable, obnoxiously monumental.
    fillb(dim,cx-15,y+1,cz-8,cx+15,y+13,cz+8,'minecraft:dark_prismarine hollow');
    fillb(dim,cx-12,y+2,cz-6,cx+12,y+11,cz+6,'minecraft:air');
    for(let x=-10;x<=10;x+=5) fillb(dim,cx+x,y+1,cz-7,cx+x+1,y+12,cz-7,'minecraft:oxidized_cut_copper');
    fillb(dim,cx-4,y+1,cz-9,cx+4,y+6,cz-7,'minecraft:air');
  }else{
    // Transit tower — stacked platforms and four skybridges.
    fillb(dim,cx-5,y+1,cz-5,cx+5,y+38,cz+5,'minecraft:dark_prismarine hollow');
    fillb(dim,cx-3,y+3,cz-3,cx+3,y+36,cz+3,'minecraft:air');
    for(const yy of [8,17,26,35]){
      fillb(dim,cx-14,y+yy,cz-2,cx+14,y+yy+1,cz+2,'minecraft:quartz_bricks');
      setb(dim,cx,y+yy+2,cz,'minecraft:sea_lantern');
    }
  }
}

function rsAuthorSignatureLandmark(dim,key,sx,sz,cx,y,cz,t){
  const v=rsLandmarkVariant(key,sx,sz);
  if(key==='glorp') rsGlorpLandmark(dim,v,cx,y,cz,t);
  else if(key==='fizz') rsFizzLandmark(dim,v,cx,y,cz,t);
  else if(key==='chrono') rsChronoLandmark(dim,v,cx,y,cz,t);
  else if(key==='scrap') rsScrapLandmark(dim,v,cx,y,cz,t);
  else if(key==='citadel') rsCitadelLandmark(dim,v,cx,y,cz,t,sx,sz);
}

// Ambient micro-motion: enough life to keep the realities from feeling frozen,
// without spawning permanent entities or creating a heavy per-tick system.
let rsAmbientTick=0;
system.runInterval(()=>{
  rsAmbientTick++;
  for(const p of world.getAllPlayers()){
    const key=rsRealityKeyForDimension(p.dimension.id);
    if(!key) continue;
    const loc=p.location;
    const phase=rsAmbientTick+(Math.floor(loc.x)+Math.floor(loc.z));
    for(let i=0;i<3;i++){
      const a=(phase*0.31)+(i*Math.PI*0.666);
      const r=5+i*3;
      const pos={x:loc.x+Math.cos(a)*r,y:loc.y+1.5+i*1.2,z:loc.z+Math.sin(a)*r};
      try{ p.dimension.spawnParticle('minecraft:basic_portal_particle',pos); }catch{}
    }
  }
},20);
'''

    twrite(script_path,script)
    return _beta_dimension_reseal(addon)


def validate(addon:Path):
    report=_reality_art_previous_validate(addon)
    errors=list(report.get('errors',[])); checks=int(report.get('checks',0))
    script=(BP/'scripts/main.js').read_text(encoding='utf-8')

    required={
      'current fogSettings API':'player.fogSettings',
      'fog component compatibility fallback':"player.getComponent('minecraft:player.fog')",
      'signature landmark author hook':'rsAuthorSignatureLandmark(dim,key,sx,sz,c.x,y,c.z,theme)',
      'deterministic landmark variants':'function rsLandmarkVariant',
      'designed route primitive':'function rsPath',
      'Glorp landmark kit':'function rsGlorpLandmark',
      'Fizz landmark kit':'function rsFizzLandmark',
      'Chrono landmark kit':'function rsChronoLandmark',
      'Scrap landmark kit':'function rsScrapLandmark',
      'Citadel landmark kit':'function rsCitadelLandmark',
      'ambient reality motion':'rsAmbientTick',
    }
    for label,needle in required.items():
        checks+=1
        if needle not in script:
            errors.append(f'reality art regression: missing {label} ({needle!r})')

    for key in ('glorp','fizz','chrono','scrap','citadel'):
        checks+=2
        fog_path=RP/f'fogs/{key}.fog.json'
        if not fog_path.exists():
            errors.append(f'reality art regression: missing fog file for {key}')
            continue
        try:
            fog=json.loads(fog_path.read_text(encoding='utf-8'))['minecraft:fog_settings']
            if 'volumetric' not in fog:
                errors.append(f'reality art regression: {key} fog missing volumetric air treatment')
            if 'air' not in fog.get('distance',{}):
                errors.append(f'reality art regression: {key} fog missing distance air treatment')
        except Exception as e:
            errors.append(f'reality art regression: bad {key} fog: {e}')

    report['checks']=checks
    report['errors']=errors
    report['status']='PASS' if not errors else 'FAIL'
    report['retail_test_72_feedback']='TRANSPORT_PASS_VISUAL_DESIGN_FAIL_SKY_EMPTY_BORING'
    report['reality_art_profile']='volumetric_fog_plus_four_landmark_variants_per_reality'
    report['reality_landmark_density']='one major deterministic authored focal landmark per streamed sector, layered over part42 enrichment'
    report['sky_strategy']='per-player fog stack + volumetric atmosphere + large celestial/horizon geometry; no nonexistent custom-dimension skybox hook claimed'
    gates=list(report.get('feature_regression_gates',[]))
    for g in ('current_player_fogsettings_api','volumetric_reality_atmosphere','signature_landmark_every_sector','four_landmark_variants_per_reality','ambient_reality_motion'):
        if g not in gates: gates.append(g)
    report['feature_regression_gates']=gates
    jwrite(OUT/'validation_report.json',report)
    return report
